{
  "name": "@subconscious/embedding-local",
  "version": "0.1.0",
  "description": "可选的进程内本地向量 provider（transformers.js + 本地 ONNX 模型，离线推理）。未安装依赖或缺模型时，core 的 EmbeddingDetector 自动回退规则检测器。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@subconscious/core": "^0.1.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
