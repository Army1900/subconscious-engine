{
  "name": "@subconscious/adapter-claude",
  "version": "0.1.0",
  "description": "Claude Code hooks 适配器：UserPromptSubmit stdin JSON → stdout hook JSON，无 UI 环境按降级矩阵注入。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "subconscious-claude-hook": "./dist/hook-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@subconscious/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
