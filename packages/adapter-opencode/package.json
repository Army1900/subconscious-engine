{
  "name": "@subconscious/adapter-opencode",
  "version": "0.1.0",
  "description": "OpenCode plugin 适配器：chat.message hook 只改当前用户消息，无交互 UI 时按降级矩阵注入候选。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@subconscious/core": "^0.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.30"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
